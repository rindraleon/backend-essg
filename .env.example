POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=your_username
POSTGRES_PASSWORD=your_password
POSTGRES_DB=your_database
APP_ENV=development
APP_DEBUG=true
APP_PORT=3000

# Ancien stockage local — plus utilisé. Conservé uniquement pour lire d'éventuelles
# références historiques /uploads/... déjà présentes en base.
UPLOAD_PATH=uploads

# Email configuration (SMTP)
# Gmail : utilisez un mot de passe d'application, pas le mot de passe du compte.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="ESSG <contact@essg.mg>"
SMTP_REPLY_TO=contact@essg.mg

# Application
NODE_ENV=development
APP_NAME=backend-essg
APP_PORT=3000
APP_URL=http://localhost:3000
UPLOAD_PATH=uploads

# Security
JWT_SECRET=fldk9pswzehv3i7nmejel
JWT_EXPIRATION=1d

# MinIO / Object storage (obligatoire — plus aucun repli disque)
# Démarrer un MinIO local : docker compose -f docker-compose.minio.yml up -d
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=essg
MINIO_PUBLIC_URL=http://localhost:9000

# Limitation de débit locale : /auth/login, /messages, /admissions
RATE_LIMIT_ENABLED=true

# Supervision : seuil d'alerte mémoire de /health (en Mo)
HEALTH_MEMORY_LIMIT_MB=512

# Mesure des performances (en-têtes X-Response-Time, logs si lent)
PERF_LOG=false
PERF_SQL=false
PERF_SLOW_MS=400

# Default admin account (created on first boot)
ADMIN_EMAIL=admin@essg.sn
ADMIN_PASSWORD=Admin@2026

# Extra CORS origins (comma-separated)
CORS_ORIGINS=

# Domaines email acceptés sans vérification DNS (séparés par des virgules).
# Les domaines institutionnels ESSG sont déjà inclus par défaut.
EMAIL_TRUSTED_DOMAINS=

# ---------------------------------------------------------------------------
# Redis — cache distribué (performance)
# REDIS_ENABLED=false : cache local en mémoire (développement, zéro config).
# REDIS_ENABLED=true  : cache partagé Redis — requis en production (plusieurs
#                       instances, survit aux redémarrages).
# ---------------------------------------------------------------------------
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---------------------------------------------------------------------------
# Sessions multi-appareils (système de présence back-office)
# Le statut d'un utilisateur est TOUJOURS calculé depuis ses sessions.
# ---------------------------------------------------------------------------
# Fenêtre « activité récente » : une session active depuis moins de X minutes
# rend l'utilisateur EN LIGNE (🟢). Au-delà : INACTIF (🟡).
SESSION_ACTIVE_WINDOW_MINUTES=15
# Inactivité maximale par session avant expiration automatique (401).
# Une session inactive entre ACTIVE_WINDOW et IDLE_EXPIRATION reste valide.
SESSION_IDLE_EXPIRATION_MINUTES=30
# Durée de vie absolue maximale d'une session (plafond glissant).
SESSION_MAX_TTL_DAYS=7
# Écriture de lastActivityAt throttlée (secondes) — présence exacte sans
# écriture à chaque requête.
SESSION_ACTIVITY_WRITE_THROTTLE_SECONDS=60
# Fréquence du balayage des sessions expirées (ms).
SESSION_SWEEP_INTERVAL_MS=60000
# Purge des sessions révoquées/expirées après N jours.
SESSION_RETENTION_DAYS=90
